{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "site-creator-vinext-starter",
  // compatibility_flags staat bewust niet hier: vite.config.ts levert
  // nodejs_compat aan en herhalen laat de Workers-runtime falen op
  // "Compatibility flag specified multiple times". De datum is de hoogste die
  // de meegeleverde workerd-binary lokaal aankan.
  "compatibility_date": "2026-05-22",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  }
}
