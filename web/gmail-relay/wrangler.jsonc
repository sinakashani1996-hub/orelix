{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "orelix-gmail-relay",
  "main": "./worker.js",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "TARGET_URL": "https://orelix-office-alpha.infocura-3460.chatgpt.site/api/webhooks/gmail"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
