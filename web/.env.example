# WorkOS AuthKit (customer login and B2B organizations)
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=
# Public application URL. Set this in Cloudflare to https://app.orelix.be.
# For local development use http://localhost:3000.
APP_BASE_URL=
# Optional explicit WorkOS callback. Defaults to APP_BASE_URL/auth/callback.
WORKOS_REDIRECT_URI=

# Google OAuth and Gmail API
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=
GMAIL_TOKEN_ENCRYPTION_KEY=
GMAIL_PUBSUB_TOPIC=
GMAIL_WEBHOOK_SECRET=
GMAIL_PUBSUB_AUDIENCE=
GMAIL_PUBSUB_SERVICE_ACCOUNT_EMAIL=

# Google Calendar OAuth (falls back to the Gmail OAuth client and encryption key
# when these values are left empty). Add the calendar callback URI in Google Cloud.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=

# Private Cloudflare Workers AI service
AI_SERVICE_URL=
AI_SHARED_SECRET=
