# Copy to .env and fill in local secrets/API keys.
# Do not commit .env.

# SignWell
# Generate under SignWell Settings > API. Keep this key local.
SIGNWELL_API_KEY=
SIGNWELL_BASE_URL=https://www.signwell.com/api/v1

# Legacy PandaDoc integration (not used by the SignWell POC)
PANDADOC_API_KEY=
PANDADOC_BASE_URL=https://api.pandadoc.com/public/v1
